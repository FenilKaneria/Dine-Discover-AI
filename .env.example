# OpenAI Configuration
# Do NOT wrap values in quotes and do not leave a quote unterminated —
# python-dotenv will silently skip the line (and the one after it).
OPENAI_API_KEY=sk-your-real-key-here

# Optional: point at a local model server (Ollama, LM Studio, vLLM, ...)
# When this is set, OPENAI_API_KEY can be any non-empty dummy value.
# OPENAI_API_BASE=http://localhost:11434/v1

# The name of the model to use
MODEL_NAME=gpt-4o-mini

# Optional: set SHARE=true to create a public Gradio link (needs internet access)
# SHARE=false
