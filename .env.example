# Do NOT wrap values in quotes and do not leave a quote unterminated —
# python-dotenv will silently skip the line (and the one after it).

# Groq (LLMs: openai/gpt-oss-20b and openai/gpt-oss-120b). OPENAI_API_KEY is accepted as a fallback name.
GROQ_API_KEY=gsk_your-groq-key-here

# Jina AI (embeddings: jina-embeddings-v3, jina-clip-v2)
JINA_API_KEY=jina_your-jina-key-here

# Optional model overrides
# CHAT_MODEL=openai/gpt-oss-20b
# REASONING_MODEL=openai/gpt-oss-120b
# EMBED_MODEL=jina-embeddings-v3
# IMAGE_EMBED_MODEL=jina-clip-v2

# Optional reranking: RERANKER=jina (cross-encoder, default) or llm (gpt-oss-120b, slow);
# RERANK=false skips reranking. SHARE=true creates a public Gradio link.
# RERANKER=jina
# RERANK_MODEL=jina-reranker-v2-base-multilingual
# RERANK=true
# SHARE=false
